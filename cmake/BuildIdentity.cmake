# Run at every build, write only when identity changes. Never query Git at runtime.
set(id "source-archive (Git metadata unavailable)")
find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE)
 execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE}" rev-parse --short=12 HEAD OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
 if(result EQUAL 0)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE}" symbolic-ref --short -q HEAD OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT branch)
   set(branch "detached")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE}" describe --tags --exact-match HEAD OUTPUT_VARIABLE tag OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE}" status --porcelain --untracked-files=no OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  set(id "git ${sha} branch ${branch}")
  if(tag)
   string(APPEND id " tag ${tag}")
  endif()
  if(dirty)
   string(APPEND id " dirty-tracked")
  else()
   string(APPEND id " clean-tracked")
  endif()
 endif()
endif()
string(REPLACE "\\" "\\\\" id "${id}")
string(REPLACE "\"" "\\\"" id "${id}")
set(content "#pragma once\n#define OPENCMR2_BUILD_ID \"${id}\"\n")
if(EXISTS "${OUTPUT}")
 file(READ "${OUTPUT}" old)
endif()
if(NOT content STREQUAL old)
 file(WRITE "${OUTPUT}" "${content}")
endif()
